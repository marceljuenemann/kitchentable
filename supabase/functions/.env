# Edge function environment for local development and CI only: `supabase start` loads this file.
# Nothing here is secret. Staging sets its own values with `supabase secrets set` (see README).
NOTIFY_ADMIN_SECRET=local-notify-admin-secret
ADMIN_EMAIL=admin@kitchentable.dating
SITE_URL=http://localhost:4200
MAILPIT_URL=http://inbucket:8025
# Stand-ins that e2e tests sign their fake Didit webhooks with. There is no DIDIT_API_KEY here, so
# "Verify my age" fails locally; to try the real (sandbox) flow, see README.
DIDIT_WEBHOOK_SECRET=local-didit-webhook-secret
DIDIT_WORKFLOW_ID=local-age-verification-workflow
