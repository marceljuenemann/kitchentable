{
  "name": "kitchentable",
  "private": true,
  "description": "An open-source, non-profit dating app, starting with a focus on the ENM (ethically non-monogamous) community in London.",
  "scripts": {
    "supabase": "supabase",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write \"web/src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"web/src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" playwright.config.ts",
    "lint": "npm run lint --prefix web",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck:e2e && npm run build --prefix web"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.9",
    "supabase": "^2.113.0",
    "typescript": "~5.9.2"
  }
}
